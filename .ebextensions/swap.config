commands:
    01_allocate_swap:
        command: "dd if=/dev/zero of=/swapfile bs=1M count=2048"
        test: "test ! -f /swapfile"
    02_set_permissions:
        command: "chmod 600 /swapfile"
        test: "test -f /swapfile && test \"$(stat -c %a /swapfile)\" != \"600\""
    03_make_swap:
        command: "mkswap /swapfile"
        test: "test -f /swapfile && ! swapon -s | grep -q /swapfile"
    04_enable_swap:
        command: "swapon /swapfile"
        test: "test -f /swapfile && ! swapon -s | grep -q /swapfile"